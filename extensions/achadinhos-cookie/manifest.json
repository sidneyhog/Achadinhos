{
  "manifest_version": 3,
  "name": "Achadinhos - Mercado Livre e Amazon",
  "version": "1.3.0",
  "description": "Manda o cookie do Mercado Livre ao painel do Achadinhos e põe o botão Enviar ao Achadinhos na página do produto da Amazon.",
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": ["https://*.mercadolivre.com.br/*", "https://*.mercadolivre.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.com.br/*/dp/*", "https://www.amazon.com.br/dp/*", "https://www.amazon.com.br/gp/product/*", "https://www.amazon.com.br/*/gp/product/*"],
      "js": ["amazon.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Cookie do Mercado Livre",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
