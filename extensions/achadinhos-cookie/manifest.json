{
  "manifest_version": 3,
  "name": "Achadinhos - Mercado Livre e Amazon",
  "version": "1.4.0",
  "description": "Manda o cookie do Mercado Livre ao painel do Achadinhos e põe os botões Enviar ao Achadinhos (produto) e Enviar todos (listas de mais vendidos) na Amazon.",
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolivre.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com.br/*/dp/*",
        "https://www.amazon.com.br/dp/*",
        "https://www.amazon.com.br/gp/product/*",
        "https://www.amazon.com.br/*/gp/product/*"
      ],
      "js": [
        "amazon.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com.br/gp/bestsellers*",
        "https://www.amazon.com.br/*/gp/bestsellers/*",
        "https://www.amazon.com.br/gp/new-releases*",
        "https://www.amazon.com.br/gp/movers-and-shakers*",
        "https://www.amazon.com.br/gp/most-wished-for*",
        "https://www.amazon.com.br/*/zgbs/*"
      ],
      "js": [
        "amazon-lista.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Cookie do Mercado Livre",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
